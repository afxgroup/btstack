; Installer script for Bluetooth for AmigaOS 4
;
; Most destinations are fixed by what the system expects: the service belongs
; in C: because bt.usbfd starts it by name, the library in LIBS:, the GUI in
; SYS:Prefs where a preferences program belongs, the AHI sub-driver and its
; mode file where AHI looks for them, the function driver where the USB stack
; looks for drivers, the firmware where the service looks for it, and the
; documentation in SYS:Documentation. Nothing here asks where to go.

(set #app-name "Bluetooth for AmigaOS 4")

(set #welcome
  (cat "\n" #app-name "\n\n"
       "A Bluetooth stack for AmigaOS 4, based on BTstack.\n\n"
       "Mice and keyboards, over both Bluetooth LE and Bluetooth Classic, "
       "feeding input.device so they drive the whole machine - and audio out "
       "to Bluetooth headphones through AHI.\n\n"
       "This will install:\n\n"
       "  BluetoothGUI      in SYS:Prefs\n"
       "  BluetoothService  in C:\n"
       "  libusb-1.library  in LIBS:\n"
       "  bluetooth.audio   in DEVS:AHI\n"
       "  BLUETOOTH         in DEVS:AudioModes\n"
       "  bt.usbfd          in DEVS:USB/fd\n"
       "  Realtek firmware  in SYS:Firmware/bt\n"
       "  the documentation   in SYS:Documentation\n"))

(set #copy-doc-help
  (cat "The documentation goes in SYS:Documentation, in a drawer of its own so "
       "it does not mix with anything else already there.\n\n"
       "It is plain text: AmigaOS has no Markdown reader, so the readme is "
       "converted when the archive is made rather than shipped as markdown "
       "nothing here can display.\n\n" @copyfiles-help))

(set #copy-gui-help
  (cat "BluetoothGUI is where you name this machine, scan for devices, pair "
       "them and forget them. It goes in SYS:Prefs because that is where a "
       "preferences program belongs, and it can be started from there like "
       "any other.\n\n" @copyfiles-help))

(set #copy-service-help
  (cat "BluetoothService is the stack itself. It goes in C: because bt.usbfd "
       "starts it by name when a Bluetooth controller is plugged in, and looks "
       "for it there.\n\n" @copyfiles-help))

(set #copy-libusb-help
  (cat "libusb-1.library is how the stack reaches the USB controller. Nothing "
       "here works without it.\n\n" @copylib-help))

(set #copy-audio-help
  (cat "bluetooth.audio is an AHI sub-driver, and BLUETOOTH is the audio mode "
       "file that tells AHI about it. AHI reads the mode file at startup and "
       "opens the driver named in it, so the two belong together: a mode file "
       "whose driver is missing gives an audio mode that cannot be used.\n\n"
       "With both installed, a Bluetooth audio mode appears in the AHI "
       "preferences and any program that plays through AHI can reach paired "
       "headphones.\n\n" @copyfiles-help))

(set #copy-usbfd-help
  (cat "bt.usbfd is a USB function driver. With it installed, plugging in a "
       "Bluetooth controller starts the service by itself, and a controller "
       "left plugged in means Bluetooth is up by the time the Workbench is.\n\n"
       "Installing it is optional: without it, run BluetoothService yourself.\n\n"
       @copyfiles-help))

(set #copy-firmware-help
  (cat "Realtek controllers hold no firmware of their own and are given it at "
       "every startup. Without it the controller comes up, answers commands "
       "and finds nothing at all - it scans and reports no devices, which "
       "looks like broken hardware and is not.\n\n"
       "Only the two files for your controller are ever read.\n\n"
       @copyfiles-help))

(set #ask-audio
  (cat "Install the AHI audio driver, so that sound can be played through "
       "Bluetooth headphones?\n\n"
       "Answer no if you only want mice and keyboards."))

(set #ask-usbfd
  (cat "Install bt.usbfd, so that plugging in a Bluetooth controller starts "
       "the service automatically?\n\n"
       "Without it you can still start BluetoothService yourself."))

(set #ask-firmware
  (cat "Install the Realtek controller firmware?\n\n"
       "Answer yes unless you know your controller is not a Realtek one, or "
       "you have already installed newer firmware. A Realtek controller "
       "without it finds no devices at all."))

(set #no-usb-drawer
  (cat "DEVS:USB does not exist, so the USB stack does not appear to be "
       "installed on this system.\n\n"
       "bt.usbfd will be skipped. Everything else is installed, and you can "
       "start BluetoothService yourself."))

(set #no-ahi
  (cat "DEVS:AHI does not exist, so AHI does not appear to be installed on "
       "this system.\n\n"
       "The audio driver will be skipped. Everything else is installed, and "
       "mice and keyboards are unaffected."))

(set #exit-msg
  (cat "\n" #app-name " is installed.\n\n"
       "Plug in a Bluetooth controller and open BluetoothGUI from the Prefs "
       "drawer, then give this machine a name and press Scan.\n\n"
       "Put your mouse or keyboard into pairing mode, and when it appears in "
       "the top list, select it and press Pair. From then on it reconnects by "
       "itself.\n\n"
       "For headphones, pair them the same way, then choose the Bluetooth "
       "mode in the AHI preferences.\n\n"
       "BluetoothStack.doc has the rest, including what to do when something "
       "does not work.\n"))

(welcome #welcome)

(complete 0)

;-----------------------------------------------------------------------------
; The documentation
;-----------------------------------------------------------------------------

(makedir "SYS:Documentation" (infos))
(set #doc-dest "SYS:Documentation/Bluetooth")
(makedir #doc-dest (infos))

(copyfiles
  (prompt "Installing the documentation in SYS:Documentation")
  (help   #copy-doc-help)
  (source "Documentation")
  (dest   #doc-dest)
  (all)
)

(complete 20)

;-----------------------------------------------------------------------------
; The parts the system expects to find in particular places
;-----------------------------------------------------------------------------

(copyfiles
  (prompt "Installing BluetoothGUI in SYS:Prefs")
  (help   #copy-gui-help)
  (source "BluetoothGUI")
  (dest   "SYS:Prefs")
  (confirm)
)

(complete 35)

(copyfiles
  (prompt "Installing BluetoothService in C:")
  (help   #copy-service-help)
  (source "C/BluetoothService")
  (dest   "C:")
  (confirm)
)

(complete 45)

; copylib compares versions, so a newer library already installed is kept
(copylib
  (prompt "Installing libusb-1.library in LIBS:")
  (help   #copy-libusb-help)
  (source "Libs/libusb-1.library")
  (dest   "LIBS:")
  (confirm)
)

(complete 55)

;-----------------------------------------------------------------------------
; The AHI sub-driver and its mode file, which go together
;-----------------------------------------------------------------------------

(if (askbool (prompt #ask-audio) (help #copy-audio-help) (default 1))
  (
    (if (exists "DEVS:AHI" (noreq))
      (
        (copyfiles
          (prompt "Installing bluetooth.audio in DEVS:AHI")
          (help   #copy-audio-help)
          (source "Devs/AHI/bluetooth.audio")
          (dest   "DEVS:AHI")
        )
        (makedir "DEVS:AudioModes")
        (copyfiles
          (prompt "Installing the audio mode file in DEVS:AudioModes")
          (help   #copy-audio-help)
          (source "Devs/AudioModes/BLUETOOTH")
          (dest   "DEVS:AudioModes")
        )
      )
      (message #no-ahi)
    )
  )
)

(complete 70)

;-----------------------------------------------------------------------------
; The USB function driver, if there is a USB stack to install it into
;-----------------------------------------------------------------------------

(if (askbool (prompt #ask-usbfd) (help #copy-usbfd-help) (default 1))
  (
    (if (exists "DEVS:USB" (noreq))
      (
        (makedir "DEVS:USB/fd")
        (copyfiles
          (prompt "Installing bt.usbfd")
          (help   #copy-usbfd-help)
          (source "Devs/USB/fd/bt.usbfd")
          (dest   "DEVS:USB/fd")
        )
      )
      (message #no-usb-drawer)
    )
  )
)

(complete 85)

;-----------------------------------------------------------------------------
; Controller firmware
;-----------------------------------------------------------------------------

(if (askbool (prompt #ask-firmware) (help #copy-firmware-help) (default 1))
  (
    (makedir "SYS:Firmware")
    (makedir "SYS:Firmware/bt")
    (copyfiles
      (prompt "Installing the controller firmware")
      (help   #copy-firmware-help)
      (source "Firmware")
      (dest   "SYS:Firmware/bt")
      (all)
    )
  )
)

(complete 100)

(exit #exit-msg)
